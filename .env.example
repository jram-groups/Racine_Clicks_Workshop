# Cashfree Payment Gateway Configuration
# WARNING: Keep CF_SECRET_KEY secure on your backend server. Never expose it in client-side code!

# Backend Server Environment Variables
CF_APP_ID=your_cashfree_app_id_here
CF_SECRET_KEY=your_cashfree_secret_key_here
CF_ENVIRONMENT=TEST # TEST (Sandbox) or PRODUCTION
CF_API_VERSION=2023-08-01

# Workshop Details
WORKSHOP_TITLE="Wedding Album Workshop"
WORKSHOP_ORGANIZER="Racine Clicks"
WORKSHOP_FEE_INR=250

# Client Configuration
CLIENT_URL=http://localhost:3000
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/invite/RacineClicksWorkshop
